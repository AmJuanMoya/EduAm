---



<div class="controlbar is-flex is-justify-content-space-between is-align-items-center mb-3 control-panel  ">
    <h2 class="title is-4 mb-0">Tabla de Usuarios</h2>
   
    <div class="field has-addons is-grouped">
        <div class="control">
            <div class="select">

                <select id="filtertable">
                    <option value="all" selected >Todos</option>
                    {tablas.map((item) => (
                            <option value={item.table_name}>{item.table_name}</option>
                        ))
                    }
                </select>

            </div>
        </div>

            <div class="field has-addons is-grouped">
        <div class="control">
            <div class="select">

                <select id="filterParam">
                    <option id="optiondefauld" value="all" selected>Parametros</option>

                    {
                     parametros.map((item) => (
                            <option value={item}>{item}</option>
                        ))
                    }

                </select>

            </div>
        </div>


        <div class="control has-icons-left is-expanded">
            <input id="buscarFiltros" class="input" type="text" placeholder="Buscar...">
            <span class="icon is-left">
                <i class="fas fa-search"></i>
            </span>
        </div>
        <div class="control">
            <button class="button is-primary btn-agregar">
                <span class="icon is-small"><i class="fas fa-plus"></i></span>
                <span>Agregar Usuario</span>
            </button>
        </div>
    </div>
  </div>

  <style> 
.controlbar{
    /* border: 1px solid red; */
    display: flex;
    flex-wrap: wrap;
    box-shadow: var(--shadowbox_1);
    border-radius: .5em;
    padding: 5px;
}
  </style>

<script  type="module">

document.addEventListener('DOMContentLoaded', () => {
    const filterTable = document.getElementById('filtertable');
    const filterParam = document.getElementById('filterParam');
    const option = document.getElementById('optiondefauld'); // Si cambias el id, cámbialo aquí también

    let tablaSeleccionada = filterTable.value;

    async function fetchRegistrosPorTabla(tabla) {
        try {
            const response = await fetch(`http://localhost:3000/api/datos/registros/${tabla}`);
            if (!response.ok) {
                throw new Error('Error en la petición');
            }
            const data = await response.json();
            console.log(data);
        } catch (error) {
            console.error('Error al obtener los registros:', error);
        }
    }

    // Llama la función cuando cambie la tabla seleccionada
    filterTable.addEventListener('change', (e) => {
        updateFilterParamState();
        fetchRegistrosPorTabla(filterTable.value);
    });




    function updateFilterParamState() {
        console.log("Actualizando estado de los parámetros de filtro");
        // Si la tabla seleccionada es "all", deshabilita el filtro de parámetros
        if (filterTable.value === 'all') {
            filterParam.disabled = true;
            filterParam.selectedIndex = 0;
            option.textContent = "Seleccione una tabla para ver los parámetros";
        } else {
            filterParam.disabled = false;
            option.textContent = "Parametros";
        }
        tablaSeleccionada = filterTable.value;
        console.log("Tabla seleccionada:", tablaSeleccionada);
        fetchRegistrosPorTabla(tablaSeleccionada);

    }


    // Llama la función al cargar la página por primera vez
    // fetchRegistrosPorTabla(filterTable.value);

    filterTable.addEventListener('change', updateFilterParamState);
});


</script>



