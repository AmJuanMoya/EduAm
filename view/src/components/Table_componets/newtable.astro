---
let {data} = Astro.props;
export const prerender = false
import {DataTable} from "simple-datatables";

---



<div class=" bg-slate-200 dark:bg-inherit text-black dark:text-white  p-3 rounded-2xl">
    <div id="table" >


</div>


<script>
    import { tableManager } from "../../services/tables/Tables.js";

    const filterTable = document.getElementById('filtertable');
// Inicializar el manager de tablas cuando el DOM esté listo
document.addEventListener('DOMContentLoaded', (e) => {
    
    console.log('DOM cargado, inicializando TableManager...');
    
    // Inicializar el manager
    if (tableManager.init()) {
        console.log('TableManager inicializado, creando tabla inicial...');
        // Crear tabla inicial
        tableManager.createTable();
    } else {
        console.error('Error al inicializar TableManager');
    }

    filterTable?.addEventListener('change',()=>{
        console.log("Refrescando tabla...")
        
    })




});
</script>






