<div class="table-container">
<table class="table is-striped is-hoverable is-fullwidth">
      <thead>
        <tr>
          <th>ID</th>
          <th>Nombre</th>
          <th>Apellido</th>
          <th>Telefono</th>
          <th>Email</th>
          <th>Rol</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody id="userTableBody">
        <tr>
          <td>1</td>
          <td>Juan</td>
          <td>Perez</td>
          <td>123456789</td>
          <td>juan.perez@example.com</td>
          <td>Administrador</td>
          <td>
            <div class="dropdown is-right is-up">
              <div class="dropdown-trigger">
                <button class="button is-small" aria-haspopup="true" aria-controls="dropdown-menu-1">
                  <span>Seleccionar</span>
                  <span class="icon is-small">
                    <i class="fas fa-angle-down" aria-hidden="true"></i>
                  </span>
                </button>
              </div>
              <div class="dropdown-menu" id="dropdown-menu-1" role="menu">
                <div class="dropdown-content">
                  <a href="#" class="dropdown-item custom-edit-btn" role="menuitem">
                    <span class="icon is-small"><i class="fas fa-edit"></i></span>
                    <span>Editar</span>
                  </a>
                  <a href="#" class="dropdown-item custom-delete-btn" role="menuitem">
                    <span class="icon is-small"><i class="fas fa-trash"></i></span>
                    <span>Eliminar</span>
                  </a>
                </div>
              </div>
            </div>
          </td>
        </tr>
        <tr>
            <td>2</td>
            <td>Maria</td>
            <td>Gomez</td>
            <td>987654321</td>
            <td>maria.gomez@example.com</td>
            <td>Editor</td>
            <td>
              <div class="dropdown is-right is-up">
                <div class="dropdown-trigger">
                  <button class="button is-small" aria-haspopup="true" aria-controls="dropdown-menu-2">
                    <span>Seleccionar</span>
                    <span class="icon is-small">
                      <i class="fas fa-angle-down" aria-hidden="true"></i>
                    </span>
                  </button>
                </div>
                <div class="dropdown-menu" id="dropdown-menu-2" role="menu">
                  <div class="dropdown-content">
                    <a href="#" class="dropdown-item custom-edit-btn" role="menuitem">
                      <span class="icon is-small"><i class="fas fa-edit"></i></span>
                      <span>Editar</span>
                    </a>
                    <a href="#" class="dropdown-item custom-delete-btn" role="menuitem">
                      <span class="icon is-small"><i class="fas fa-trash"></i></span>
                      <span>Eliminar</span>
                    </a>
                  </div>
                </div>
              </div>
            </td>
          </tr>
      </tbody>
    </table>
  </div>

