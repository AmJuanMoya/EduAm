---


// Componentes
import ButtonA from "./general/button_a.astro";

// Iconos

---

<div class="w-80 p-4 space-y-4 shadow-lg z-20 dark:bg-slate-800/90 bg-slate-400 flex-col flex-shrink-0
            fixed top-0 left-0 h-screen hidden
            lg:w-1/5 lg:flex lg:static" id="sidebar">
  <div class="text-2xl font-bold text-center border-b text-blue-900 dark:text-blue-500 border-gray-700 pb-4">
    Eduam
  </div>
  <nav class="flex-1 space-y-2 " id="nav-menu-options">
    <!-- Las opciones del menú se renderizarán aquí -->
  </nav>
</div>

<div class="lg:hidden fixed bottom-4 right-4 z-30">
  <button id="hamburger-button" class="bg-blue-600 text-white p-3 rounded-full shadow-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const sidebar = document.getElementById("sidebar");
    const hamburgerButton = document.getElementById("hamburger-button");
    const navMenuOptions = document.getElementById("nav-menu-options");

    let userRole: string | null = null;
    let user_id: string | null = null;
    
      userRole = localStorage.getItem("user_rol"); // Obtener directamente 'user_rol'
      user_id = localStorage.getItem("user_id")
      // console.log("el rol es: ", userRole)

    interface MenuItem {
      name: string;
      href: string;
    }

    const menuOptions: Record<string, MenuItem[]> = {
      1: [
        { name: "Dashboard", href: "/admin/adminpanel" },
        { name: "Estudiantes", href: "/matriculas/listarMatriculas" },
        { name: "Profesores", href: "/docentes/perfildocente" },
        { name: "Acudientes", href: "/Acudientes/listarAcudientes" },
        { name: "Matrículas", href: "/matriculas/registroMatriculas" },
        { name: "Actividades", href: "/Actividades/crearActividad" },
        { name: "Cursos", href: "/Cursos/cursos" },
        // { name: "Consultas", href: "/consultas" },
        { name: "Usuarios", href: "/usuario/registroUsuario" },
      ],
      3: [
        { name: "Mi Perfil", href: `/estudiantes/${user_id}` },
        { name: "Mis Cursos", href: "/Cursos/cursos" },
        { name: "Mis Actividades", href: "/Actividades/crearActividad" },
        { name: "Mis Notas", href: "/informes/calificaciones" },
      ],
      2: [
        { name: "Mi Perfil", href: "/docentes/perfildocente" },
        { name: "Mis Cursos", href: "/Cursos/cursos" },
        { name: "Registrar Calificaciones", href: "/informes/registro" },
        { name: "Mis Actividades", href: "/Actividades/crearActividad" },
      ],
      4: [
        // { name: "Mi Perfil", href: "/Acudientes/listarAcudientes" },
        { name: "Mis Estudiantes", href: "/estudiantes/misEstudiantes" },
      ],
      Guest: [] // Rol por defecto sin opciones
    };

    function renderMenu(role: string) {
      if (!navMenuOptions) return; // Null check

      navMenuOptions.innerHTML = ""; // Limpiar opciones existentes
      const options = menuOptions[role] || [];

      if (options.length === 0) {
        const noOptionsMessage = document.createElement("p");
        noOptionsMessage.className = "text-gray-400 p-2";
        noOptionsMessage.textContent = "No hay opciones que mostrar";
        navMenuOptions.appendChild(noOptionsMessage);
        return;
      }

      options.forEach((option: MenuItem) => {
        const link = document.createElement("a");
        link.href = option.href;
        link.className =
          "flex items-center space-x-3 p-2 border border-blue-800/50 rounded-lg text-gray-300 dark:hover:bg-gray-700 hover:bg-gray-300  hover:text-blue-300 transition-colors duration-200";
        link.innerHTML = `
          <span class=" text-blue-950 dark:text-blue-300">${option.name}</span>
        `;
        navMenuOptions.appendChild(link);
      });
    }

    if (userRole) {
      renderMenu(userRole);
    } else {
      console.log("No se encontró rol de usuario en localStorage.");
      renderMenu("Guest");
    }
    
    const desktopSidebarToggle = document.getElementById("desktop-sidebar-toggle");

    if (hamburgerButton && sidebar) {
      hamburgerButton.addEventListener("click", () => {
        // Toggle para móvil
        if (window.innerWidth < 1024) {
          sidebar.classList.toggle("hidden");
          sidebar.classList.toggle("flex");
        }
      });
    }

    if (desktopSidebarToggle && sidebar) {
      desktopSidebarToggle.addEventListener("click", () => {
        // Toggle para desktop
        if (window.innerWidth >= 1024) {
          sidebar.classList.toggle("hidden");
          sidebar.classList.toggle("flex");
        }
      });
    }

  });
</script>