---
let {options} = Astro.props
let {NameAside = "Menu por defecto"} = Astro.props
export const prerender = false

const optionsDefault = options ?? { inicio: "/", Consultas: "/consultas" };
const optionNames = [...Object.keys(optionsDefault), ]
---


<!-- Menu tipo asidebar -->


      <div id="drawer" class=" mx-3 w-65 dark:bg-slate-950/40  rounded-md p-2">


        <aside class="menu">
          <div class="flex justify-evenly">
            <p class="text-center text-slate-500/50 mb-5"> {NameAside}</p>
            <!-- Boton X para cerrar el menu -->
            <svg id="btnClose" data-drawer-hide="drawer"  class="w-5 h-5 text-gray-800 dark:text-white/50 rounded-sm hover:scale-115 hover:text-blue-500 hover:rotate-90 duration-400 hover:cursor-pointer  hover:bg-slate-500/50" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 17.94 6M18 18 6.06 6"/>
            </svg>
            
          </div>
            <ul class="menu-list">

              <!-- <li> <a href="/">Inicio</a></li> -->
              {optionNames.map((name) => (
                <li class="flex dark:hover:bg-slate-700/80 pl-4 border-l-2 rounded-r-md hover:border-l-blue-500 p-1 my-2  transition-colors duration-200"><a class=" w-[100%]" href={optionsDefault[name]}>{name}</a></li>
              ))}



            </ul>
        </aside>

      </div>


      <script >
        import { Drawer } from "flowbite";

        document.addEventListener("DOMContentLoaded",()=>{
          let dawerT = document.getElementById("drawer")
          let btnClose = document.getElementById("btnClose")
          const drawer = new Drawer(dawerT);

          // btnClose?.addEventListener("click", ()=>{
          //   drawer.toggle();
          // })
          

        })


        // Si usas navegación SPA, escucha el evento de navegación y vuelve a inicializar
         // Evento de Astro para navegación interna
      </script>