---
import General from "../../layouts/general.astro";
import Asidebar from "../../components/asidebar.astro";
import Panelnav from "../../components/navigation/panelnav.astro";
---

<General>
  <Panelnav />

  <h1 class="bg-slate-700 text-xl text-center h-10 m-3 rounded-xl">
    Consulta actividades
  </h1>

  <div class="bg-slate-900 flex">
    <Asidebar />

    <div class="flex-1 p-4 bg-slate-900 flex flex-col gap-4 mt-2">

      <!-- Formulario -->
      <div class="bg-slate-800 p-4 rounded-md shadow">
        <label for="documentoEstudiante" class="text-white">Documento Estudiante</label>
        <input
          type="number"
          id="documentoEstudiante"
          placeholder="Ej: 1020304050"
          class="bg-slate-700 text-white p-3 rounded-md w-full sm:w-64 border border-gray-600 focus:ring-blue-500 focus:border-blue-500 mt-1"
          required />
        <button
          id="consultarBtn"
          class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-xl mt-4">
          Consultar
        </button>
      </div>

      <!-- Contenedor de tabla -->
      <div id="table" class="mt-6 border border-slate-600 rounded-md p-2 text-white">
        <p class="text-slate-400">Esperando consulta...</p>
      </div>

      <!-- Scripts -->
      <!-- 1. Cargar tableManager desde public/scripts -->
      <script type="module" src="/scripts/tableManager.js"></script>

      <!-- 2. Script para manejar el fetch y renderizar la tabla -->
      <script type="module">
        const input = document.getElementById("documentoEstudiante");
        const button = document.getElementById("consultarBtn");
        const tablaContainer = document.getElementById("table");

        button.addEventListener("click", async () => {
          const doc = input.value.trim();
          if (!doc) return alert("Por favor ingresa un número de documento válido");

          try {
            console.log("📡 Consultando al backend...");
            const res = await fetch(`http://localhost:3000/api/datos/actividades/estudiante/${doc}`);
            const data = await res.json();

            console.log("📦 Respuesta recibida:", data);

            if (data.message) {
              tablaContainer.innerHTML = `<p class="text-yellow-400">${data.message}</p>`;
              return;
            }

            tablaContainer.innerHTML = ""; // Limpiar resultados anteriores
            window.tableManager.init(data);
            window.tableManager.createTable();
          } catch (error) {
            console.error("❌ Error al consultar:", error);
            tablaContainer.innerHTML = `<p class="text-red-500">Error al consultar actividades.</p>`;
          }
        });
      </script>
    </div>
  </div>
</General>