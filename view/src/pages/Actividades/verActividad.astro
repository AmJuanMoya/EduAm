---
import General from "../../layouts/general.astro";
import Asidebar from "../../components/asidebar.astro";
import Panelnav from "../../components/navigation/panelnav.astro";
---

<General>
  <Panelnav />

  <h1 class="bg-slate-700 text-xl text-center h-10 m-3 rounded-xl">
    Ver Detalles de Actividad
  </h1>

  <div class="bg-slate-900 flex">
    <Asidebar />

    <div class="flex-1 p-4 bg-slate-900 flex flex-col gap-4 mt-2 items-center">

      <!-- Formulario -->
    <div class="bg-slate-800 p-6 rounded-xl shadow-xl max-w-md w-full">
    <h2 class="text-lg font-semibold text-white mb-3">🔍 Buscar Actividad por ID</h2>

    <label for="actividadId" class="text-slate-300 text-sm font-medium">ID de la Actividad</label>
    <input
    type="number"
    id="actividadId"
    placeholder="Ej: 1"
    class="bg-slate-700 text-white p-3 rounded-lg w-full mt-1 border border-slate-600 focus:ring-2 focus:ring-blue-500 outline-none"
    required
    />
    <button
    id="buscarBtn"
    class="bg-blue-600 hover:bg-blue-700 transition-colors duration-200 text-white font-semibold py-2 px-6 rounded-lg mt-4 w-full"
  >
    Buscar
  </button>
</div>

      <!-- Contenedor del resultado -->
      <div id="actividadDetalle" class="w-full max-w-md mt-6 text-white"></div>

      <!-- Script -->
      <script type="module" src="/scripts/actividadDetalle.js"></script>
    </div>
  </div>
</General>
