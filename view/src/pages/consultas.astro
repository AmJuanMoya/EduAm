---
import General from "../layouts/general.astro"
import Asidebar from "../components/asidebar.astro"
import GestionTable from "../layouts/gestionTable.astro"
import Newtable from "../components/Table_componets/newtable.astro"
import Panelnav from "../components/navigation/panelnav.astro"
import { object } from "astro:schema";

let datos = [];
let filas = [];
let columnas = []

try {
  const res = await fetch('http://localhost:3000/api/datos/tablas');
  if (res.ok) {
    datos = await res.json();

  }
} catch (e) {
  datos = [];
}


---


<General>


  <Panelnav />

      <section class="flex  ">
       
        <Asidebar />
        <div class="flex justify-center  w-full">
          <!-- <GestionTable  tablas={datos} /> -->
           <Newtable/>
       </div> 



</section>



</General>




