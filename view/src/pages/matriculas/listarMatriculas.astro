---
// Parte de servidor de Astro
import Panelnav from "../../components/navigation/panelnav.astro";
import General from "../../layouts/general.astro";
import Asidebar from "../../components/asidebar.astro";
import ModalMatricula from "../../components/modalMatricula/modal.astro";

// Esto se ejecuta en el servidor al renderizar la página
let todasLasMatriculas = [];

try {
  const response = await fetch("http://localhost:3000/api/datos/matricula");
  todasLasMatriculas = await response.json();
} catch (error) {
  console.error("Error al obtener las matrículas:", error);
}
---


<General>
  
  <Panelnav />
  <div class="flex min-h-screen bg-[#0A0E22] text-gray-100">

    <Asidebar />
  
    <div class="flex-1 p-6">
    
      <h1 class="text-3xl font-bold mb-6">Listado de Matrículas</h1>

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <input
          id="buscar"
          type="text"
          placeholder="Buscar por nombre o documento"
          class="px-3 py-2 rounded bg-gray-800 border border-gray-600 w-full sm:w-64 text-sm placeholder:text-gray-400"
        />

        <div class="text-sm">
          <label for="cantidad" class="mr-2">Registros por página:</label>
          <select
            id="cantidad"
            class="bg-gray-800 border border-gray-600 rounded px-4 py-2 text-base w-32"
          >
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
        </div>
      </div>

      <div id="contenedor" class="bg-[#0A0E22] shadow rounded-lg p-4 overflow-x-auto">
        <p class="text-gray-400">Cargando matrículas...</p>
      </div>
    </div>
  </div>

  <ModalMatricula />

  <script type="module">

    const contenedor = document.getElementById("contenedor");
    const buscarInput = document.getElementById("buscar");
    const cantidadSelect = document.getElementById("cantidad");
    

    let todasLasMatriculas = [];
    let registrosPorPagina = parseInt(cantidadSelect.value);
    let paginaActual = 1;
    let criterioOrden = "id_matricula";
    let ordenAscendente = true;


    const getColorClase = (estado) => {
      switch (estado) {
        case "Activa": return "bg-green-600 text-white";
        case "Pendiente": return "bg-gray-500 text-white";
        case "Cancela": return "bg-red-600 text-white";
        case "Retirada": return "bg-yellow-400 text-black";
        case "Condicional": return "bg-blue-600 text-white";
        default: return "bg-gray-700 text-white";
      }
    };

    async function cargarMatriculas() {
  try {
    const res = await fetch("http://localhost:3000/api/datos/matricula");
    const data = await res.json();
    todasLasMatriculas = data;
    window.__TODAS_MATRICULAS = data; // 🔥 Aquí
    renderizarTabla();
  } catch (error) {
    contenedor.innerHTML = "<p class='text-red-500'>Error al cargar los datos.</p>";
    console.error("Error:", error);
  }
}


    function renderizarTabla() {
      const filtro = buscarInput.value.toLowerCase();
      const filtrados = todasLasMatriculas.filter(m =>
        `${m.primer_nombre_estudiante} ${m.primer_apellido_estudiante}`.toLowerCase().includes(filtro) ||
        String(m.documento_estudiante).includes(filtro)
      );

      if (criterioOrden) {
        filtrados.sort((a, b) => {
          const valorA = a[criterioOrden];
          const valorB = b[criterioOrden];
          return ordenAscendente ? (valorA > valorB ? 1 : -1) : (valorA < valorB ? 1 : -1);
        });
      }

      const inicio = (paginaActual - 1) * registrosPorPagina;
      const fin = inicio + registrosPorPagina;
      const pagina = filtrados.slice(inicio, fin);

      if (pagina.length === 0) {
        contenedor.innerHTML = "<p class='text-gray-400'>No hay resultados.</p>";
        return;
      }

      let tablaHTML = `
        <table class="min-w-full table-auto text-sm bg-[#0A0E22] text-white">
          <thead class="bg-gray-700 text-gray-100 uppercase text-xs">
            <tr class="border-b border-white/10">
              <th class="px-4 py-2 text-left cursor-pointer" data-orden="id_matricula">ID</th>
              <th class="px-4 py-2 text-left cursor-pointer" data-orden="primer_nombre_estudiante">Estudiante</th>
              <th class="px-4 py-2 text-left cursor-pointer" data-orden="documento_estudiante">Documento</th>
              <th class="px-4 py-2 text-left">Estado</th>
              <th class="px-4 py-2 text-left">Jornada</th>
            </tr>
          </thead>
          <tbody>
            ${pagina.map(m => `
              <tr class="border-b border-white/10 hover:bg-white/5 cursor-pointer fila-matricula" data-doc="${m.documento_estudiante}">
                <td class="px-4 py-2">${m.id_matricula}</td>
                <td class="px-4 py-2">${m.primer_nombre_estudiante} ${m.primer_apellido_estudiante}</td>
                <td class="px-4 py-2">${m.documento_estudiante}</td>
                <td class="px-4 py-2">
                  <span class="px-2 py-1 rounded-full text-xs font-semibold ${getColorClase(m.estado_matricula)}">
                    ${m.estado_matricula}
                  </span>
                </td>
                <td class="px-4 py-2">${m.jornada}</td>
              </tr>
            `).join("")}
          </tbody>
        </table>
        <p class="mt-4 text-sm text-gray-400">Mostrando ${pagina.length} de ${filtrados.length} resultados.</p>
      `;

      contenedor.innerHTML = tablaHTML;

      const paginacion = document.createElement("div");
      paginacion.className = "flex items-center justify-center gap-2 mt-4";

      const totalPaginas = Math.ceil(filtrados.length / registrosPorPagina);

      if (totalPaginas > 1) {
        const crearBoton = (texto, pagina, deshabilitado = false) => {
          const btn = document.createElement("button");
          btn.textContent = texto;
          btn.className = `px-3 py-1 rounded ${paginaActual === pagina ? 'bg-blue-600 text-white' : 'bg-gray-700 text-gray-100 hover:bg-gray-600'} ${deshabilitado ? 'opacity-50 cursor-not-allowed' : ''}`;
          if (!deshabilitado) {
            btn.addEventListener("click", () => {
              paginaActual = pagina;
              renderizarTabla();
            });
          }
          return btn;
        };

        paginacion.appendChild(crearBoton("Anterior", paginaActual - 1, paginaActual === 1));

        for (let i = 1; i <= totalPaginas; i++) {
          paginacion.appendChild(crearBoton(i, i));
        }

        paginacion.appendChild(crearBoton("Siguiente", paginaActual + 1, paginaActual === totalPaginas));
      }

      contenedor.appendChild(paginacion);


      document.querySelectorAll("th[data-orden]").forEach(th => {
        th.addEventListener("click", () => {
          const campo = th.dataset.orden;
          if (criterioOrden === campo) {
            ordenAscendente = !ordenAscendente;
          } else {
            criterioOrden = campo;
            ordenAscendente = true;
          }
          renderizarTabla();
        });
      });
    }

  
  document.addEventListener("click", (e) => {
  const fila = e.target.closest(".fila-matricula");
  if (fila) {
    const documento = fila.dataset.doc;
    const matricula = todasLasMatriculas.find(m => String(m.documento_estudiante) === documento);
    if (!matricula) return;

    // Mostrar el modal y pasarle los datos
    window.mostrarModalMatricula(matricula);
  }
});


// Cerrar el modal al hacer clic en la X
document.addEventListener("DOMContentLoaded", () => {
  const cerrar = document.getElementById("cerrarModalBtn");
  if (cerrar) {
    cerrar.addEventListener("click", () => {
      const modal = document.getElementById("modalMatricula");
      modal.classList.add("hidden");
    });
  }
});


    buscarInput.addEventListener("input", () => {
      paginaActual = 1;
      renderizarTabla();
    });

    cantidadSelect.addEventListener("change", () => {
      registrosPorPagina = parseInt(cantidadSelect.value);
      paginaActual = 1;
      renderizarTabla();
    });

    cargarMatriculas();
    window.__TODAS_MATRICULAS = todasLasMatriculas; 
  </script>
</General>