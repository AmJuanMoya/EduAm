---
import Panelnav from "../../components/navigation/panelnav.astro";
import Navbar from "../../components/general/navbar.astro";
import General from "../../layouts/general.astro";
import Asidebar from "../../components/asidebar.astro";
import ModalMatricula from "../../components/modalMatricula/modal.astro";
import MenuMatricula from "./c_menumatricula.astro"

---

<!-- <link href="https://cdn.jsdelivr.net/npm/flowbite@2.5.1/dist/flowbite.min.css" rel="stylesheet" />  -->
<script src="https://cdn.jsdelivr.net/npm/simple-datatables@9.0.3"></script>

<General>
<Navbar></Navbar>
<Panelnav></Panelnav>
<MenuMatricula></MenuMatricula>

<div class=" m-5 p-3 h-screen flex gap-5">
  <Asidebar></Asidebar> 


<div class="bg-white dark:bg-gray-800 rounded-lg shadow w-full p-6">
  <h1 class="flex justify-center font-bold text-2xl">Matriculas</h1>
  <table id="data-table" class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
    <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
      <tr>
        <th scope="col" class="px-6 py-3">ID Documento</th>
        <th scope="col" class="px-6 py-3">Nombre</th>
        <th scope="col" class="px-6 py-3">Apellido</th>
        <th scope="col" class="px-6 py-3">Año Matrícula</th>
        <th scope="col" class="px-6 py-3">Grado</th>
        <th scope="col" class="px-6 py-3">Repite</th>
        <th scope="col" class="px-6 py-3">Traslado</th>
        <th scope="col" class="px-6 py-3">Estado</th>
        <th scope="col" class="px-6 py-3">Jornada</th>
      </tr>
    </thead>
    <tbody id="tbodyMatriculas" class="divide-y divide-gray-200 dark:divide-gray-700">
      <!-- se rellena desde JS -->
    </tbody>
  </table>
</div>
</div>

<script type="module">
(async function () {
  // DOM
  const table = document.getElementById("data-table");
  const tbody = document.getElementById("tbodyMatriculas");
  
  let datatable = null;
  let matriculas = [];

  const DATATABLE_OPTIONS = {
    searchable: true,
    fixedHeight: true,
    perPage: 10,
    perPageSelect: [3, 5, 10, 15, 20],
    labels: {
      placeholder: "Buscar...",
      perPage: "Registros por página",
      noRows: "No hay matrículas para mostrar",
      info: "Mostrando {start} a {end} de {rows} registros",
    },
  };

  // Cargar datos + (re)inicializar datatable
  async function cargarMatriculas() {
    if (datatable && typeof datatable.destroy === "function") {
      try { datatable.destroy(); } catch {}
      datatable = null;
    }

    try {
      const res = await fetch("http://localhost:3000/api/datos/matricula");
      if (!res.ok) throw new Error("HTTP " + res.status);
      matriculas = await res.json();
      console.log("Datos cargados:", matriculas);
    } catch (err) {
      console.error("Error cargando matrículas:", err);
      tbody.innerHTML = `<tr><td colspan="8" class="px-4 py-3 text-center text-gray-400">Error cargando matrículas</td></tr>`;
      return;
    }

    renderRows();
    datatable = new simpleDatatables.DataTable("#data-table", DATATABLE_OPTIONS);
  }

  // Render filas
  function renderRows() {
    tbody.innerHTML = "";
    if (!Array.isArray(matriculas) || matriculas.length === 0) {
      tbody.innerHTML = `<tr><td colspan="8" class="px-4 py-3 text-center text-gray-400">No hay matrículas registradas</td></tr>`;
      return;
    }

    const frag = document.createDocumentFragment();
    matriculas.forEach(m => {
      const tr = document.createElement("tr");
      tr.className = "hover:bg-gray-100 dark:hover:bg-gray-700";

      const td = (txt, cls = "") => {
        const cell = document.createElement("td");
        cell.className = `px-4 py-3 border-b border-gray-200 dark:border-gray-700 ${cls} text-gray-550 dark:text-gray-400`.trim();
        cell.textContent = txt ?? "";
        return cell;
      };

      tr.appendChild(td(m.id_documento));
      tr.appendChild(td(m.estu_nombre));
      tr.appendChild(td(m.estu_apellido));
      tr.appendChild(td(new Date(m.matr_anio).toLocaleDateString()));
      tr.appendChild(td(m.nombre_grado));
      
      // Repite
      const repiteTd = document.createElement("td");
      repiteTd.className = "px-4 py-3 border-b border-gray-200 dark:border-gray-700";
      const repiteSpan = document.createElement("span");
      repiteSpan.className = `text-xs font-medium px-2.5 py-0.5 rounded ${
        m.matr_repite === 1 
          ? 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300' 
          : 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300'
      }`;
      repiteSpan.textContent = m.matr_repite === 1 ? 'Sí' : 'No';
      repiteTd.appendChild(repiteSpan);
      tr.appendChild(repiteTd);

      // Traslado
      const trasladoTd = document.createElement("td");
      trasladoTd.className = "px-4 py-3 border-b border-gray-200 dark:border-gray-700";
      const trasladoSpan = document.createElement("span");
      trasladoSpan.className = `text-xs font-medium px-2.5 py-0.5 rounded ${
        m.matr_traslado === 1 
          ? 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300' 
          : 'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-300'
      }`;
      trasladoSpan.textContent = m.matr_traslado === 1 ? 'Sí' : 'No';
      trasladoTd.appendChild(trasladoSpan);
      tr.appendChild(trasladoTd);

      // Estado
      const estadoTd = document.createElement("td");
      estadoTd.className = "px-4 py-3 border-b border-gray-200 dark:border-gray-700";
      const estadoSpan = document.createElement("span");
      estadoSpan.className = `text-xs font-medium px-2.5 py-0.5 rounded ${
        m.matr_estado === 'Activa' 
          ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300'
          : m.matr_estado === 'Condicionada'
          ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300'
          : m.matr_estado === 'Cancelada'
          ? 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300'
          : 'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-300'
      }`;
      estadoSpan.textContent = m.matr_estado;
      estadoTd.appendChild(estadoSpan);
      tr.appendChild(estadoTd);

      tr.appendChild(td(m.matr_jornada));

      frag.appendChild(tr);
    });

    tbody.appendChild(frag);
  }

  // Init
  await cargarMatriculas();
})();
</script>
</General>