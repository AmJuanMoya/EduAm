---
import Panelnav from "../../components/navigation/panelnav.astro";
import General from "../../layouts/general.astro";
import Asidebar from "../../components/asidebar.astro";

let identificacion = [];

try {
  const res = await fetch("http://localhost:3000/api/datos/tipo_identificacion");
  if (res.ok) {
    identificacion = await res.json();
  } else {
    // Es buena práctica manejar el caso en que la respuesta no es OK
    console.error(`Error al obtener identificaciones: ${res.status} - ${res.statusText}`);
  }
} catch (error) {
  // Captura cualquier error de red o de la solicitud
  console.error("Error al realizar la solicitud de tipo_identificacion:", error);
}

---

<General>
<Panelnav/>    

<main class="   flex">
    <Asidebar/>
    <div class=" w-full mx-5 ">
        
        <form id="registroMatriculaForm" action="" method="POST" class=" dark:bg-slate-950/90 w-[75%]  mx-auto p-5 overflow-auto resize ">
          <h1 class="text-center text-3xl my-3">Registro de Matriculas</h1>
            <fieldset class="border border-slate-500/50 p-3 rounded-lg "> <legend class="">DATOS DEL ESTUDIANTE</legend>
                
                <div class="mx-auto w-fit">
                  <div class="flex">
                    <label for="primer_nombre_estudiante" class="block"> Primer Nombre: </label>
                    <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span>
                  </div> 

                 <input id="primer_nombre_estudiante" name="primer_nombre_estudiante" type="text" placeholder="Juan" class="m-5 rounded-sm w-200" required>
                </div>

                <div class="mx-auto w-fit">
                  <div class="flex">
                  <label for="nombres_adicionales_estudiante" class="block ">Nombres Adicionales:</label>
                  <!-- <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span> -->
                </div>  
                 <input id="nombres_adicionales_estudiante" name="nombres_adicionales_estudiante" type="text" placeholder="Miguel." class="m-5 rounded-sm w-200">    
                </div>
                 
                <div class="mx-auto w-fit"> 
                  <div class="flex">
                  <label id="primer_apellido_estudiante" for="" class="block ">Primer Apellido: </label>
                  <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span> 
                </div>
                  <input id="primer_apellido_estudiante" name="primer_apellido_estudiante" type="text" placeholder="Moya" class="m-5 rounded-sm w-200" required>
                </div>
                  
                <div class="mx-auto w-fit">    
                  <label id="apellidos_adicionales_estudiante" for="" class="block w-50">Apellidos adicionales:</label>
                  <input id="apellidos_adicionales_estudiante" name="apellidos_adicionales_estudiante" type="text" placeholder="Miguel." class="m-5 rounded-sm w-200">    
                </div>

                <div class="mx-auto w-fit">    
                  <div class="flex">
                  <label for="documento_estudiante" class="block ">Numero de Documento:</label>
                  <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span> 
                </div>  
                  <div class="m-5 flex  w-200 ">
                    <select name="id_tipo_documento_estudiante" id="id_tipo_documento_estudiante" class="rounded-l-md" required>
                      <!-- <option value="">T.I</option>
                      <option value="">C.C</option>
                      <option value="">C.E</option> -->

                      {identificacion.map((d) => {
                        return <option value={d.id_identificacion}>{d.tipo_identificacion}</option>;
                        })}
                    </select>
                    <input id="documento_estudiante" name="documento_estudiante" type="text" required placeholder=1000009  pattern="^[1-9]\d{6,9}$"  class="rounded-r-sm w-190 ">
                  </div>
                </div>

                <div class="mx-auto w-fit">    
                  <label for="eps" class="block  ">EPS: <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span>  <span class="text-sm text-slate-500">(Si no tiene eps coloque no coloque Nada. Se asumira que tiene Sisben)</span></label>
                  <input id="eps" name="eps" type="text" placeholder="Ej. Compensar" class="m-5 rounded-sm w-200">    
                </div>

                <div class="mx-auto w-fit">    
                  <label for="estrato" class="block w-50 ">Estrato Socioeconomico:<span class="text-red-600  text-xl ml-1 -mt-1.5">*</span> </label>
                  <input id="estrato" name="estrato" type="number"min=1 max=10 placeholder="Ej. 3" class="m-5 rounded-sm w-200">
                </div>

                <!-- ESTADO MATRICULA Y FECHA MATRICULA SE ASIGNAN DEPENDIENDO DE QUIEN REALIZE
                     EL FORMULARIO 
                     -- SI LA REALIZA UN ADMINISTRATIVO DEBEN HABER MAS PASOS DE VALIDACION.

                     -- SI LA REALIZA UN PADRE DE FAMILIA EN ESTE CASO SE CREA AUTMATICAMENTE Y SE ENVIAN
                        PARCIALEMTE LOS DATOS. -->

                <!-- <label for="">El estudiante es repitente</label>
                <div></div>-->
                <div class="mx-auto w-210">   
                  <label for="" class="text-left block mb-2 ">¿El estudiante es repitente?  <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span> </label>
                  <div class="w-fit ml-5 p-1 ">
                    <input name="repitente" type="radio" value=true class="mx-3"> Si
                    <input name="repitente" type="radio" value=false class="mx-3">No
                  </div>
                </div>

                <div class="mx-auto w-fit mt-5">    
                  <label for="jornada" class="block w-fit ">¿En que jordanada le gustaria que el estudiante se encontrase?  <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span> </label>

                  <select name="jornada" id="jornada" class="m-5 rounded-sm w-200">
                    <option  selected disabled value="0" class=""  >Seleccione</option>
                    <option value="Tarde">Tarde</option>
                    <option value="Mañana">Mañana</option>
                  </select>
                </div>

                <div class="mx-auto w-fit">    
                  <label for="direccion_residencia" class="block w-50 ">Direccion de Residencia  <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span> </label>
                  <input id="direccion_residencia" name="direccion_residencia" type="text"  placeholder="Carrera 19 A # 1-1 Puente aranda" class="m-5 rounded-sm w-200">
                </div>

                <div class="mx-auto w-fit mt-5">    
                  <label for="discapacidad" class="block w-fit " >¿El estudiante tiene alguna discapacidad que debamos conocer?</label>
                  <textarea name="discapacidad" id="discapacidad" placeholder="Puede dejar este espacio vacio si no la tiene." class="bg-inherit m-5 rounded-sm w-200"></textarea>
                </div>

            </fieldset>




            <fieldset class="border border-slate-500/50 p-3 rounded-lg mt-7 ">  <legend class="">DATOS ACUDIENTE</legend>

                <div class="mx-auto w-fit">
                 <label for="nombre_acudiente1" class="block  w-50"> Primer Nombre: <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span>  </label>
                 <input id="nombre_acudiente1" name="nombre_acudiente1" type="text" placeholder="Kevin" class="m-5 rounded-sm w-200" required>
                </div>

                <!-- <div class="mx-auto w-fit">
                 <label for="" class="block  w-50">Nombres Adicionales: </label>
                 <input type="text" placeholder="---" class="m-5 rounded-sm w-200" >
                </div> -->

                 <div class="mx-auto w-fit">
                 <label for="	apellido_acudiente1" class="block  w-50"> Primer Apellido: <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span>  </label>
                 <input id="	apellido_acudiente1" name="	apellido_acudiente1" type="text" placeholder="Carrillo" class="m-5 rounded-sm w-200" required>
                </div>

                 <div class="mx-auto w-fit">    
                  <label for="numero_documento_acudiente1" class="block w-50 ">Numero de Documento:  <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span> </label>
                  <div class="m-5 flex  w-200 ">
                    <select name="id_tipo_documento_acudiente1" id="id_tipo_documento_acudiente1" class="rounded-l-md">
                      <!-- <option value="cc">C.C</option>
                      <option value="ti">T.I</option>
                      <option value="ce">C.E</option> -->
                      {identificacion.map((d) => {
                        return <option value={d.id_identificacion}>{d.tipo_identificacion}</option>;
                        })}
                    </select>
                    <input id="numero_documento_acudiente1" name="numero_documento_acudiente1" type="text" placeholder=1000009  pattern="^[1-9]\d{6,9}$"  class="rounded-r-sm w-190 " required>
                  </div>
                </div>


                <div class="mx-auto w-fit">
                 <label for="tel_contacto_acudiente1" class="block  w-50">Telefono de Contacto: <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span></label>
                 <input id="tel_contacto_acudiente1" name="tel_contacto_acudiente1" type="text" placeholder="123456789" class="m-5 rounded-sm w-200" required>
                </div>

                <div class="mx-auto w-fit">
                 <label for="correo_acudiente1" class="block  w-50">Correo electronico: <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span> </label>
                 <input id="correo_acudiente1" name="correo_acudiente1" type="email" placeholder="kevinM@gmail.com" class="m-5 rounded-sm w-200" required>
                </div>

            </fieldset>

            <fieldset class="border border-slate-500/50 p-3 rounded-lg mt-7 ">  <legend class="">OTROS</legend>

                  <div class="mx-auto w-fit mt-5">    
                  <label for="observaciones" class="block w-fit " >Aqui puede dejar una observacion si debamos de tener algo en cuenta.</label>
                  <textarea name="observaciones" id="observaciones" placeholder="Puede dejar este espacio vacio si no la tiene." class="bg-inherit m-5 rounded-sm w-200"></textarea>
                </div>
            </fieldset>

            <div class="flex justify-center mt-8">
          <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50">
            Registrar Matrícula
          </button>
        </div>
            

        </form>
    </div>
</main>

</General>

<script is:inline>
    const form = document.getElementById('registroMatriculaForm');

    form.addEventListener('submit', async (event) => {
      event.preventDefault(); // Evitar el envío predeterminado del formulario

      const formData = new FormData(form);
      const data = {};

      // Convertir FormData a un objeto JSON
      for (const [key, value] of formData.entries()) {
        // Manejar el radio button 'repitente' para que sea un booleano
        if (key === 'repitente') {
          data[key] = value === 'true';
        } else {
          data[key] = value;
        }
      }

      console.log('Datos a enviar:', data); // Para depuración

      try {
        const response = await fetch('http://localhost:3000/api/crear', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          const result = await response.json();
          alert('Matrícula registrada exitosamente: ' + result.message);
          form.reset(); // Limpiar el formulario después del éxito
        } else {
          const errorData = await response.json();
          alert('Error al registrar matrícula: ' + errorData.message);
          console.error('Error del servidor:', errorData);
        }
      } catch (error) {
        alert('Ocurrió un error al conectar con el servidor.');
        console.error('Error de red o de solicitud:', error);
      }
    });
  </script>

