---
import Panelnav from "../../components/navigation/panelnav.astro";
import General from "../../layouts/general.astro";
import Asidebar from "../../components/asidebar.astro";

let identificacion = [];

try {
  const res = await fetch("http://localhost:3000/api/datos/tipo_identificacion");
  if (res.ok) {
    identificacion = await res.json();
  } else {
    // Es buena práctica manejar el caso en que la respuesta no es OK
    console.error(`Error al obtener identificaciones: ${res.status} - ${res.statusText}`);
  }
} catch (error) {
  // Captura cualquier error de red o de la solicitud
  console.error("Error al realizar la solicitud de tipo_identificacion:", error);
}

---

