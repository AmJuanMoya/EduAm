---
import General from "../../layouts/general.astro";
import Asidebar from "../../components/asidebar.astro";
import Navbar from "../../components/general/navbar.astro";
import Panelnav from "../../components/navigation/panelnav.astro";
import MenuMatricula from  "./c_menumatricula.astro"
---

<General>
  <Navbar></Navbar>
  <Panelnav></Panelnav>
  <MenuMatricula></MenuMatricula>
<section class="min-h-screen flex flex-col lg:flex-row">
  <Asidebar/>

  <div class="flex-1 p-4 lg:p-8">
    <div class="max-w-4xl mx-auto">
      <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-blue-200 dark:border-gray-600 overflow-hidden">
        <!-- Header -->
        <div class="bg-gradient-to-r from-blue-600 to-blue-700 dark:from-blue-800 dark:to-blue-900 px-6 py-8 text-white">
          <h1 class="text-2xl lg:text-3xl font-bold mb-2">Registro de Estudiante</h1>
          <p class="text-blue-100 dark:text-blue-200">Complete la información del estudiante</p>
        </div>

        <!-- Form -->
        <form id="registroForm" class="p-6 lg:p-8">
          <fieldset class="border-0">
            <legend class="sr-only">Datos del Estudiante</legend>
            
            <!-- Grid responsivo mejorado -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6">
              <!-- Documento -->
              <div class="sm:col-span-2 lg:col-span-1">
                <label class="block text-gray-700 dark:text-gray-300 font-semibold mb-2 text-sm">
                  Documento <span class="text-red-500">*</span>
                </label>
                <input 
                  type="number" 
                  name="id_docuestudiante" 
                  required 
                  placeholder="Número de documento" 
                  min="1" 
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 hover:bg-gray-50 dark:hover:bg-gray-600" 
                />
              </div>

              <!-- Nombre -->
              <div class="sm:col-span-2 lg:col-span-1">
                <label class="block text-gray-700 dark:text-gray-300 font-semibold mb-2 text-sm">
                  Nombre <span class="text-red-500">*</span>
                </label>
                <input 
                  type="text" 
                  name="estu_nombre" 
                  required 
                  placeholder="Nombres completos" 
                  pattern="^[A-Za-zÁÉÍÓÚáéíóúÑñ\s]{2,}$" 
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 hover:bg-gray-50 dark:hover:bg-gray-600" 
                />
              </div>

              <!-- Apellido -->
              <div class="sm:col-span-2 lg:col-span-1">
                <label class="block text-gray-700 dark:text-gray-300 font-semibold mb-2 text-sm">
                  Apellido <span class="text-red-500">*</span>
                </label>
                <input 
                  type="text" 
                  name="estu_apellido" 
                  required 
                  placeholder="Apellidos completos" 
                  pattern="^[A-Za-zÁÉÍÓÚáéíóúÑñ\s]{2,}$" 
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 hover:bg-gray-50 dark:hover:bg-gray-600" 
                />
              </div>

              <!-- Edad -->
              <div>
                <label class="block text-gray-700 dark:text-gray-300 font-semibold mb-2 text-sm">
                  Edad <span class="text-red-500">*</span>
                </label>
                <input 
                  type="number" 
                  name="estu_edad" 
                  required 
                  placeholder="Edad" 
                  min="1" 
                  max="120" 
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 hover:bg-gray-50 dark:hover:bg-gray-600" 
                />
              </div>

              <!-- Género -->
              <div>
                <label class="block text-gray-700 dark:text-gray-300 font-semibold mb-2 text-sm">
                  Género <span class="text-red-500">*</span>
                </label>
                <select 
                  name="estu_genero" 
                  required 
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-600"
                >
                  <option value="">Seleccione género</option>
                  <option value="MASCULINO">Masculino</option>
                  <option value="FEMENINO">Femenino</option>
                  <option value="OTRO">Otro</option>
                </select>
              </div>

              <!-- Tipo de documento -->
              <div>
                <label class="block text-gray-700 dark:text-gray-300 font-semibold mb-2 text-sm">
                  Tipo de documento <span class="text-red-500">*</span>
                </label>
                <select 
                  name="estu_tipo_documento" 
                  required 
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-600"
                >
                  <option value="">Seleccione tipo</option>
                  <option value="CC">CC</option>
                  <option value="TI">TI</option>
                  <option value="CE">CE</option>
                </select>
              </div>

              <!-- Estado -->
              <div>
                <label class="block text-gray-700 dark:text-gray-300 font-semibold mb-2 text-sm">
                  Estado <span class="text-red-500">*</span>
                </label>
                <select 
                  name="estu_estado" 
                  required 
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-600"
                >
                  <option value="">Seleccione estado</option>
                  <option value="Activo">Activo</option>
                  <option value="Bloqueado">Bloqueado</option>
                  <option value="Pendiente">Pendiente</option>
                  <option value="Inactivo">Inactivo</option>
                  <option value="Condicionado">Condicionado</option>
                </select>
              </div>

              <!-- Correo -->
              <div>
                <label class="block text-gray-700 dark:text-gray-300 font-semibold mb-2 text-sm">
                  Correo electrónico
                </label>
                <input 
                  type="email" 
                  name="est_correo" 
                  placeholder="ejemplo@correo.com" 
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 hover:bg-gray-50 dark:hover:bg-gray-600" 
                />
              </div>

              <!-- Contraseña -->
              <div>
                <label class="block text-gray-700 dark:text-gray-300 font-semibold mb-2 text-sm">
                  Contraseña <span class="text-red-500">*</span>
                </label>
                <input 
                  type="password" 
                  name="est_contrasena" 
                  required 
                  placeholder="Mínimo 6 caracteres" 
                  minlength="6" 
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 hover:bg-gray-50 dark:hover:bg-gray-600" 
                />
              </div>

              <!-- Rol -->
              <!-- <div>
                <label class="block text-gray-700 dark:text-gray-300 font-semibold mb-2 text-sm">
                  Rol <span class="text-red-500">*</span>
                </label>
                <input 
                  type="number" 
                  name="estu_rol" 
                  required 
                  placeholder="ID del rol" 
                  min="1" 
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 hover:bg-gray-50 dark:hover:bg-gray-600" 
                />
              </div> -->

              <!-- Acudiente -->
              <div>
                <label class="block text-gray-700 dark:text-gray-300 font-semibold mb-2 text-sm">
                  Acudiente
                </label>
                <input 
                  type="number" 
                  name="estu_acudiente" 
                  placeholder="ID del acudiente" 
                  min="1" 
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 hover:bg-gray-50 dark:hover:bg-gray-600" 
                />
              </div>

              <!-- Observaciones -->
              <div class="sm:col-span-2 lg:col-span-3">
                <label class="block text-gray-700 dark:text-gray-300 font-semibold mb-2 text-sm">
                  Observaciones del estudiante
                </label>
                <textarea 
                  name="estu_observaciones" 
                  placeholder="Observaciones adicionales..." 
                  rows="3"
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 hover:bg-gray-50 dark:hover:bg-gray-600 resize-none"
                ></textarea>
              </div>
            </div>

            <!-- Mensajes de error -->
            <div id="formErrors" class="mt-6 p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg text-red-600 dark:text-red-400 font-medium hidden"></div>

            <!-- Botones -->
            <div class="flex flex-col sm:flex-row gap-4 mt-8">
              <button 
                type="submit" 
                class="flex-1 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 dark:from-blue-700 dark:to-blue-800 dark:hover:from-blue-800 dark:hover:to-blue-900 text-white font-bold px-8 py-4 rounded-lg shadow-lg transition-all duration-200 transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800"
              >
                <span class="flex items-center justify-center">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                  </svg>
                  Registrar Estudiante
                </span>
              </button>
              
              <button 
                type="button" 
                onclick="window.history.back()" 
                class="flex-1 bg-gray-500 hover:bg-gray-600 dark:bg-gray-600 dark:hover:bg-gray-700 text-white font-bold px-8 py-4 rounded-lg shadow-lg transition-all duration-200 transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800"
              >
                Cancelar
              </button>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById('registroForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const form = e.target;
    const data = Object.fromEntries(new FormData(form).entries());
    let errors = [];

    // Validaciones JS adicionales
    if (!data.id_docuestudiante || isNaN(data.id_docuestudiante) || Number(data.id_docuestudiante) < 1) {
      errors.push("Documento válido requerido.");
    }
    if (!data.estu_nombre || !/^[A-Za-zÁÉÍÓÚáéíóúÑñ\s]{2,}$/.test(data.estu_nombre)) {
      errors.push("Nombre requerido (solo letras, mínimo 2 caracteres).");
    }
    if (!data.estu_apellido || !/^[A-Za-zÁÉÍÓÚáéíóúÑñ\s]{2,}$/.test(data.estu_apellido)) {
      errors.push("Apellido requerido (solo letras, mínimo 2 caracteres).");
    }
    if (!data.estu_edad || isNaN(data.estu_edad) || Number(data.estu_edad) < 1 || Number(data.estu_edad) > 120) {
      errors.push("Edad válida requerida.");
    }
    if (!data.estu_genero) {
      errors.push("Seleccione género.");
    }
    if (!data.estu_tipo_documento) {
      errors.push("Seleccione tipo de documento.");
    }
    if (!data.estu_estado) {
      errors.push("Seleccione estado.");
    }
    if (data.est_correo && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.est_correo)) {
      errors.push("Correo electrónico inválido.");
    }
    if (!data.est_contrasena || data.est_contrasena.length < 6) {
      errors.push("Contraseña mínimo 6 caracteres.");
    }
    // if (!data.estu_rol || isNaN(data.estu_rol) || Number(data.estu_rol) < 1) {
    //   errors.push("Rol válido requerido.");
    // }
    if (data.estu_acudiente && (isNaN(data.estu_acudiente) || Number(data.estu_acudiente) < 1)) {
      errors.push("Acudiente debe ser numérico.");
    }

    // Para mostrar errores en el registro
    const errorDiv = document.getElementById('formErrors');
    if (errors.length > 0) {
      errorDiv.innerHTML = errors.join("<br>");
      errorDiv.classList.remove('hidden');
      errorDiv.scrollIntoView({ behavior: 'smooth' });
      return;
    } else {
      errorDiv.classList.add('hidden');
    }

    // Envío de datos
    try {
      const response = await fetch('http://localhost:3000/api/estudiantes/registro', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      
      const result = await response.json();
      console.log('Respuesta del servidor:', result);
      
      if (response.ok) {
        // Mostrar mensaje de éxito
        alert('Estudiante registrado exitosamente');
        // form.reset();
        errorDiv.classList.add('hidden');
      } else {
        // Manejar errores del servidor (400, 500, etc.)
        console.error('Error del servidor:', result);
        
        // Mostrar el mensaje de error del servidor
        let errorMessage = 'Error al registrar el estudiante';
        
        if (result.error) {
          errorMessage = result.error;
        } else if (result.message) {
          errorMessage = result.message;
        } else {
          // Mensajes específicos según el código de estado
          switch (response.status) {
            case 400:
              errorMessage = 'Datos inválidos. Verifique la información ingresada.';
              break;
            case 401:
              errorMessage = 'No autorizado. Inicie sesión nuevamente.';
              break;
            case 403:
              errorMessage = 'No tiene permisos para realizar esta acción.';
              break;
            case 404:
              errorMessage = 'Servicio no encontrado.';
              break;
            case 409:
              errorMessage = 'El estudiante ya existe en el sistema.';
              break;
            case 422:
              errorMessage = 'Datos de entrada inválidos.';
              break;
            case 500:
              errorMessage = 'Error interno del servidor. Intente más tarde.';
              break;
            default:
              errorMessage = `Error del servidor (${response.status}). Intente nuevamente.`;
          }
        }
        
        errorDiv.innerHTML = errorMessage;
        errorDiv.classList.remove('hidden');
        errorDiv.scrollIntoView({ behavior: 'smooth' });
      }
      
    } catch(error) {
      console.error('Error en la solicitud:', error);
      
      // Manejar errores de conexión
      let errorMessage = 'Error de conexión. Verifique su internet e intente nuevamente.';
      
      if (error.name === 'TypeError' && error.message.includes('fetch')) {
        errorMessage = 'No se pudo conectar con el servidor. Verifique que el servidor esté funcionando.';
      } else if (error.name === 'SyntaxError') {
        errorMessage = 'Error al procesar la respuesta del servidor.';
      }
      
      errorDiv.innerHTML = errorMessage;
      errorDiv.classList.remove('hidden');
      errorDiv.scrollIntoView({ behavior: 'smooth' });
    }
  });
</script>
</General>
