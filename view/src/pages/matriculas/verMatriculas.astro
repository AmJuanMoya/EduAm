---
import Panelnav from "../../components/navigation/panelnav.astro";
import General from "../../layouts/general.astro";
import Asidebar from "../../components/asidebar.astro";
import ModalMatricula from "../../components/modalMatricula/detalleMatricula.astro";
import Navbar from "../../components/general/navbar.astro";
import MenuMatricula from  "./c_menumatricula.astro"
---

<General>
<Navbar></Navbar>
<MenuMatricula></MenuMatricula>
  <Panelnav />
  <div class="flex min-h-screen  dark:bg-[#0A0E22] text-gray-900 dark:text-gray-100">
    <Asidebar />

    
    <div class="flex-1 p-6 space-y-6">
      

      <h1 class="text-3xl font-bold">Consulta de Matrícula</h1>

      
        <div class="bg-[#2A2D46] p-4 rounded shadow space-y-2 text-white">
        <label for="documento" class="block text-sm font-medium text-white">Documento del estudiante:</label>
        <div class="flex gap-2">
          <input id="documento" type="text" placeholder="Ingrese documento"
            class="w-full px-3 py-2 border border-gray-500 rounded bg-[#1F2235] text-white placeholder-gray-400" />
          <button id="buscarBtn"
            class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded transition">Buscar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Contenedor para el modal (inicialmente oculto) -->
  <div id="modal-container"></div>

  <!-- Componente del modal -->
  <ModalMatricula />

  <script type="module">
    const buscarBtn = document.getElementById("buscarBtn");

    buscarBtn.addEventListener("click", async () => {
      const doc = document.getElementById("documento").value.trim();
      if (!doc) {
        alert("Ingrese un documento válido.");
        return;
      }

      try {
        const res = await fetch(`http://localhost:3000/api/datos/matricula/${doc}`);
        const data = await res.json();

        if (!Array.isArray(data) || data.length === 0 || data?.error) {
          alert("No se encontró ninguna matrícula.");
          return;
        }

        const event = new CustomEvent("abrirModalMatricula", { detail: data[0] });
        window.dispatchEvent(event);

      } catch (err) {
        console.error(err);
        alert("Error al buscar matrícula.");
      }
    });
  </script>
</General>

  
