---
import Panelnav from "../../components/navigation/panelnav.astro";
import General from "../../layouts/general.astro";
import Asidebar from "../../components/asidebar.astro";
---

<General>
  <div class="flex min-h-screen bg-gray-50 dark:bg-[#0A0E22]  text-gray-900 dark:text-gray-100">
    <!-- Sidebar -->
    <Asidebar />

    <!-- Contenido principal -->
    <div class="flex-1 p-6 space-y-6">
      <Panelnav />

      <h1 class="text-3xl font-bold">Consulta de Matrícula </h1>

      <!-- Buscador -->
      <div class="bg-white dark:bg-gray-800 p-4 rounded shadow space-y-2">
        <label for="documento" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Documento del estudiante:</label>
        <div class="flex gap-2">
          <input id="documento" type="text" placeholder="Ingrese documento"
            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100" />
          <button id="buscarBtn"
            class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded transition">Buscar</button>
        </div>
        <div id="resultados" class="mt-6 text-sm text-gray-700 dark:text-gray-300 space-y-4"></div>
      </div>
    </div>
  </div>

  <script type="module">
    const getColorClase = (estado) => {
      switch (estado) {
        case "Activa": return "bg-green-200 text-green-800 dark:bg-green-900 dark:text-green-300";
        case "Pendiente": return "bg-gray-300 text-gray-800 dark:bg-gray-700 dark:text-gray-200";
        case "Cancela": return "bg-red-200 text-red-800 dark:bg-red-900 dark:text-red-300";
        case "Retirada": return "bg-yellow-200 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300";
        case "Condicional": return "bg-blue-200 text-blue-800 dark:bg-blue-900 dark:text-blue-300";
        default: return "bg-gray-200 text-gray-800 dark:bg-gray-600 dark:text-gray-100";
      }
    };

    document.getElementById("buscarBtn").addEventListener("click", async () => {
      const doc = document.getElementById("documento").value.trim();
      const resultados = document.getElementById("resultados");
      resultados.innerHTML = "";

      if (!doc) {
        resultados.innerHTML = "<p class='text-yellow-500'>Ingrese un documento válido.</p>";
        return;
      }

      try {
        const res = await fetch(`http://localhost:3000/api/datos/matricula/${doc}`);
        const data = await res.json();

        if (!Array.isArray(data) || data.length === 0 || data?.error) {
          resultados.innerHTML = "<p class='text-red-400'>No se encontró ninguna matrícula.</p>";
          return;
        }

        const m = data[0];

        resultados.innerHTML = `
          <div class="bg-gray-100 dark:bg-gray-800 p-4 rounded border border-gray-300 dark:border-gray-700 space-y-4">

            <div>
              <h2 class="text-lg font-semibold border-b pb-1 mb-2">Datos del estudiante</h2>
              <p><strong>ID Matrícula:</strong> ${m.id_matricula}</p>
              <p><strong>Nombres:</strong> ${m.primer_nombre_estudiante} ${m.nombres_adicionales_estudiante || ""}</p>
              <p><strong>Apellidos:</strong> ${m.primer_apellido_estudiante} ${m.apellidos_adicionales_estudiante || ""}</p>
              <p><strong>Tipo Documento:</strong> ${m.id_tipo_documento_estudiante}</p>
              <p><strong>Documento:</strong> ${m.documento_estudiante}</p>
              <p><strong>EPS:</strong> ${m.eps || "No registrado"}</p>
              <p><strong>SISBEN:</strong> ${m.sisben || "No registrado"}</p>
              <p><strong>Estrato:</strong> ${m.estrato}</p>
              <p><strong>Discapacidad:</strong> ${m.discapacidad || "Ninguna"}</p>
              <p><strong>Dirección:</strong> ${m.direccion_residencia}</p>
              <p><strong>Repitente:</strong> ${m.repitente ? "Sí" : "No"}</p>
            </div>

            <div>
              <h2 class="text-lg font-semibold border-b pb-1 mb-2">Datos de la matrícula</h2>
              <p><strong>Fecha de Matrícula:</strong> ${m.fecha_matricula}</p>
              <p><strong>Jornada:</strong> ${m.jornada}</p>
              <p><strong>Estado:</strong> 
                <span class="px-2 py-1 rounded-full text-sm font-medium ${getColorClase(m.estado_matricula)}">
                  ${m.estado_matricula}
                </span>
              </p>
              <p><strong>Observaciones:</strong> ${m.observaciones || "Ninguna"}</p>
            </div>

            <div>
              <h2 class="text-lg font-semibold border-b pb-1 mb-2">Acudiente del estudiante</h2>
              <p><strong>Nombre:</strong> ${m.nombre_acudiente1} ${m.apellido_acudiente1}</p>
              <p><strong>Tipo Documento:</strong> ${m.id_tipo_documento_acudiente1}</p>
              <p><strong>Documento:</strong> ${m.numero_documento_acudiente1}</p>
              <p><strong>Teléfono:</strong> ${m.tel_contacto_acudiente1}</p>
              <p><strong>Correo:</strong> ${m.correo_acudiente1 || "No registrado"}</p>
            </div>

            ${m.nombre_acudiente2 ? `
              <div>
                <h2 class="text-lg font-semibold border-b pb-1 mb-2">Acudiente 2</h2>
                <p><strong>Nombre:</strong> ${m.nombre_acudiente2} ${m.apellido_acudiente2}</p>
                <p><strong>Tipo Documento:</strong> ${m.id_tipo_documento_acudiente2}</p>
                <p><strong>Documento:</strong> ${m.numero_documento_acudiente2}</p>
                <p><strong>Teléfono:</strong> ${m.tel_contacto_acudiente2}</p>
                <p><strong>Correo:</strong> ${m.correo_acudiente2 || "No registrado"}</p>
              </div>
            ` : ""}

            ${m.nombre_acudiente3 ? `
              <div>
                <h2 class="text-lg font-semibold border-b pb-1 mb-2">Acudiente 3</h2>
                <p><strong>Nombre:</strong> ${m.nombre_acudiente3} ${m.apellido_acudiente3}</p>
                <p><strong>Tipo Documento:</strong> ${m.id_tipo_documento_acudiente3}</p>
                <p><strong>Documento:</strong> ${m.numero_documento_acudiente3}</p>
                <p><strong>Teléfono:</strong> ${m.tel_contacto_acudiente3}</p>
                <p><strong>Correo:</strong> ${m.correo_acudiente3 || "No registrado"}</p>
              </div>
            ` : ""}
          </div>
        `;
      } catch (err) {
        console.error(err);
        resultados.innerHTML = "<p class='text-red-400'>Error al buscar matrícula.</p>";
      }
    });
  </script>
</General>
