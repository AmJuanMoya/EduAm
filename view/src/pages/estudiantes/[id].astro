---
export const prerender = false;
import General from "../../layouts/general.astro";
import Asidebar from "../../components/asidebar.astro";
import Navbar from "../../components/general/navbar.astro";
import Panelnav from "../../components/navigation/panelnav.astro";

let  id_e  = Astro.params.id ; // Necesitamos el ID del estudiante de la URL
---

<General title="Perfil de Estudiante">
    <Navbar></Navbar>
    <Panelnav></Panelnav>
    <section class="flex">
        <Asidebar />
        <main class="flex-1 p-10 bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white min-h-screen ">
            <div class=" mx-auto bg-white  dark:bg-gray-800 shadow-xl rounded-xl p-8 md:p-12 ">
                <h1 class="text-5xl font-extrabold text-center mb-12 text-blue-800 dark:text-blue-400">Perfil del Estudiante</h1>

                <div id="student-profile-content">
                    <p class="text-center text-xl text-gray-600 dark:text-gray-300">Cargando información del estudiante...</p>
                </div>
            </div>
        </main>
    </section>
</General>

<script  define:vars={{id_e}}>


    document.addEventListener('DOMContentLoaded', async () => {
        const studentId = id_e; // ID del estudiante de la URL, accesible aquí
        const token = localStorage.getItem('token'); // Obtener el token del localStorage
        const studentProfileContent = document.getElementById('student-profile-content');

        if (!studentId || !token) {
            if (studentProfileContent) {
                studentProfileContent.innerHTML = '<p class="text-center text-red-500 text-xl font-medium">No autorizado: ID de estudiante o token no encontrados en la sesión.</p>';
            }
            return;
        }

        try {
            const response = await fetch(`http://localhost:3000/api/estudiantes/${studentId}`, {
                headers: {
                    'Authorization': `Bearer ${token}`
                }
            });
            const data = await response.json();

            if (response.ok) {
                if (studentProfileContent) {
                    const studentData = data[0];
                    studentProfileContent.innerHTML = `
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                            <div class="bg-blue-50 dark:bg-gray-700 p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300">
                                <h2 class="text-3xl font-bold mb-5 text-blue-700 dark:text-blue-300 border-b pb-3 border-blue-200 dark:border-gray-600">Datos Personales</h2>
                                <div class="space-y-4">
                                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center p-3 bg-blue-100 dark:bg-gray-600 rounded-md shadow-sm">
                                        <span class="font-semibold text-blue-800 dark:text-blue-200 text-lg">Documento:</span>
                                        <span class="text-gray-800 dark:text-gray-100 text-xl">${studentData.id_docuestudiante}</span>
                                    </div>
                                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center p-3 bg-blue-100 dark:bg-gray-600 rounded-md shadow-sm">
                                        <span class="font-semibold text-blue-800 dark:text-blue-200 text-lg">Nombre:</span>
                                        <span class="text-gray-800 dark:text-gray-100 text-xl">${studentData.estu_nombre}</span>
                                    </div>
                                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center p-3 bg-blue-100 dark:bg-gray-600 rounded-md shadow-sm">
                                        <span class="font-semibold text-blue-800 dark:text-blue-200 text-lg">Apellido:</span>
                                        <span class="text-gray-800 dark:text-gray-100 text-xl">${studentData.estu_apellido}</span>
                                    </div>
                                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center p-3 bg-blue-100 dark:bg-gray-600 rounded-md shadow-sm">
                                        <span class="font-semibold text-blue-800 dark:text-blue-200 text-lg">Edad:</span>
                                        <span class="text-gray-800 dark:text-gray-100 text-xl">${studentData.estu_edad}</span>
                                    </div>
                                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center p-3 bg-blue-100 dark:bg-gray-600 rounded-md shadow-sm">
                                        <span class="font-semibold text-blue-800 dark:text-blue-200 text-lg">Género:</span>
                                        <span class="text-gray-800 dark:text-gray-100 text-xl">${studentData.estu_genero}</span>
                                    </div>
                                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center p-3 bg-blue-100 dark:bg-gray-600 rounded-md shadow-sm">
                                        <span class="font-semibold text-blue-800 dark:text-blue-200 text-lg">Tipo de Documento:</span>
                                        <span class="text-gray-800 dark:text-gray-100 text-xl">${studentData.estu_tipo_documento}</span>
                                    </div>
                                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center p-3 bg-blue-100 dark:bg-gray-600 rounded-md shadow-sm">
                                        <span class="font-semibold text-blue-800 dark:text-blue-200 text-lg">Estado:</span>
                                        <span class="text-gray-800 dark:text-gray-100 text-xl">${studentData.estu_estado}</span>
                                    </div>
                                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center p-3 bg-blue-100 dark:bg-gray-600 rounded-md shadow-sm">
                                        <span class="font-semibold text-blue-800 dark:text-blue-200 text-lg">Correo:</span>
                                        <span class="text-gray-800 dark:text-gray-100 text-xl">${studentData.est_correo}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="bg-green-50 dark:bg-gray-700 p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300">
                                <h2 class="text-3xl font-bold mb-5 text-green-700 dark:text-green-300 border-b pb-3 border-green-200 dark:border-gray-600">Información Académica</h2>
                                <div class="space-y-4">
                                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center p-3 bg-green-100 dark:bg-gray-600 rounded-md shadow-sm">
                                        <span class="font-semibold text-green-800 dark:text-green-200 text-lg">Rol:</span>
                                        <span class="text-gray-800 dark:text-gray-100 text-xl">${studentData.estu_rol==3?"Estudiante":studentData.estu_rol}</span>
                                    </div>
                                    <div class="p-3 bg-green-100 dark:bg-gray-600 rounded-md shadow-sm">
                                        <p class="text-gray-700 dark:text-gray-300 text-lg">Aún no hay tareas o calificaciones disponibles.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                }
            } else {
                if (studentProfileContent) {
                    studentProfileContent.innerHTML = `<p class="text-center text-red-500 text-xl font-medium">Error al cargar el perfil: ${data.error || 'Desconocido'}</p>`;
                }
            }
        } catch (error) {
            console.error('Error al obtener el perfil del estudiante:', error);
            if (studentProfileContent) {
                studentProfileContent.innerHTML = '<p class="text-center text-red-500 text-xl font-medium">Error de conexión con el servidor.</p>';
            }
        }
    });
</script>