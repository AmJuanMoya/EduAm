<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login Colegio</title>

    <!-- CDN de Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- CDN de Flowbite CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.css" rel="stylesheet" />
</head>
<body class="min-h-screen w-screen relative bg-blue-50 font-sans">
    <!-- Contenedor del fondo con imagen y superposición de degradado -->
    <div class="absolute inset-0 z-0">
        <!-- Imagen de fondo. Se usa un placeholder genérico ya que la original es local.
             En un entorno real, reemplazar con una URL accesible o tu propia imagen. -->
        <img src="../../../imgs/estudiantes.jpg" alt="Fondo estudiantes" class="w-full h-full object-cover" />
        <!-- Superposición de degradado para el efecto visual y oscurecimiento -->
        <div class="absolute inset-0 bg-gradient-to-br from-blue-800 via-purple-700 to-red-700 opacity-60 backdrop-blur-md"></div>
    </div>

    <!-- Contenido principal centrado en la pantalla -->
    <div class="relative z-10 flex flex-col items-center justify-center min-h-screen px-4 py-8">
        <!-- Sección del escudo y la frase -->
        <div class="flex flex-col items-center mb-6 text-center">
            <!-- Escudo. Se usa un placeholder genérico. Reemplazar con la URL de tu escudo. -->
            <img src="../../../imgs/escudo-alm.webp" alt="Escudo Colegio" class="w-28 md:w-36 mb-3 drop-shadow-xl rounded-full" />
            <p class="text-white italic text-lg md:text-xl font-semibold">"UNA VIDA PARA LA EXCELENCIA"</p>
        </div>

        <!-- Contenedor del formulario de inicio de sesión -->
        <div class="bg-white bg-opacity-90 p-6 md:p-8 rounded-xl shadow-2xl w-full max-w-sm md:max-w-md">
            <h2 class="text-2xl font-bold text-center mb-6 text-gray-800">Iniciar Sesión</h2>

            <!-- Formulario de acceso -->
            <form class="space-y-6">
                <!-- Campo de entrada para el usuario con etiqueta flotante (Flowbite) -->
                <div class="relative">
                    <input type="text" id="usuario" class="peer block w-full appearance-none border border-gray-300 bg-transparent px-2.5 pb-2.5 pt-4 text-sm text-gray-900 rounded-lg focus:outline-none focus:ring-0 focus:border-blue-600" placeholder=" " required />
                    <label for="usuario" class="absolute text-sm text-gray-500 duration-300 transform -translate-y-4 scale-75 top-2 z-10 origin-[0] left-2.5 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-2 peer-focus:scale-75 peer-focus:-translate-y-4">Usuario</label>
                </div>

                <!-- Campo de entrada para la contraseña con etiqueta flotante (Flowbite) -->
                <div class="relative">
                    <input type="password" id="password" class="peer block w-full appearance-none border border-gray-300 bg-transparent px-2.5 pb-2.5 pt-4 text-sm text-gray-900 rounded-lg focus:outline-none focus:ring-0 focus:border-blue-600" placeholder=" " required />
                    <label for="password" class="absolute text-sm text-gray-500 duration-300 transform -translate-y-4 scale-75 top-2 z-10 origin-[0] left-2.5 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-2 peer-focus:scale-75 peer-focus:-translate-y-4">Contraseña</label>
                </div>

                <!-- Enlace para recuperar contraseña -->
                <div class="flex justify-end">
                    <a href="contrasena" class="text-xs text-blue-600 hover:underline">¿Has olvidado tu contraseña?</a>
                </div>

                <!-- Botón de acceso -->
                <button type="submit" class="w-full text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center transition-colors duration-200">Acceder</button>

                <!-- Botones sociales (Google y GitHub) -->
                <div class="flex flex-col sm:flex-row justify-between mt-4 gap-2">
                    <!-- Botón de Google -->
                    <button type="button" class="flex w-full justify-center items-center text-white bg-red-600 hover:bg-red-700 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 transition-colors duration-200">
                        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/google/google-original.svg" class="w-5 h-5 mr-2" alt="Google icon" />
                        Google
                    </button>

                    <!-- Botón de GitHub -->
                    <button type="button" class="flex w-full justify-center items-center text-white bg-gray-800 hover:bg-gray-900 focus:ring-4 focus:outline-none focus:ring-gray-300 font-medium rounded-lg text-sm px-5 py-2.5 transition-colors duration-200">
                        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/github/github-original.svg" class="w-5 h-5 mr-2" alt="GitHub icon" />
                        GitHub
                    </button>
                </div>

                <!-- Enlace para volver al inicio -->
                <div class="text-center mt-4">
                    <a href="#" class="text-sm text-gray-600 hover:underline">Volver al inicio</a>
                </div>
            </form>
        </div>
    </div>

    <!-- CDN de Flowbite JS (debe ir al final del body para un mejor rendimiento)
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.js"></script> -->
</body>
</html>
