---

import '../../styles/global.css';


export const prerender = false;
const { id } = Astro.params;
let userData = {};
try {
    
    const response = await fetch(`http://localhost:3000/api/datos/usuario/${id}`);

    if (response.ok) {
        userData = await response.json(); 
    } else {

        console.error(`Error al obtener el perfil para el ID ${id}:`, response.status, response.statusText);
   
    }
} catch (error) {
 
    console.error('Error al conectar con el backend o al parsear la respuesta:', error);
}

---
