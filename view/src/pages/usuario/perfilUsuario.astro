---
import Panelnav from "../../components/navigation/panelnav.astro";
import General from "../../layouts/general.astro";
import Asidebar from "../../components/asidebar.astro";


const userId = 1; // este lo sacas luego del login/sesión
const userType = "estudiante"; // o "empleado", según corresponda

const res = await fetch(`http://127.0.0.1:3000/api/perfil/${userId}/${userType}`);
const user = await res.json();
---

<General>
    <div class="flex min-h-screen bg-[#0A0E22] text-gray-100">
    <Asidebar />

    <div class="perfil">
        <br>
        <img src="https://via.placeholder.com/100" alt="Foto de perfil">
<h2>{user.nombre} {user.apellido}</h2>
<p>@{user.usuario}</p>
<p>Rol: {userType}</p>
</div>

        
                    
                    
                    
                

    </div>
</General>
