---
import Panelnav from "../../components/navigation/panelnav.astro";
import General from "../../layouts/general.astro";
import Asidebar from "../../components/asidebar.astro";
---

<link href="https://cdn.jsdelivr.net/npm/flowbite@2.5.1/dist/flowbite.min.css" rel="stylesheet" /> 
<script src="https://cdn.jsdelivr.net/npm/simple-datatables@9.0.3"></script>

<General>
  <Panelnav />
  <div class="flex min-h-screen">
    <Asidebar />

    <div class="flex-1 p-6">
      <h1 class="text-3xl font-bold mb-6">Listado de Acudientes</h1>

      <!-- Tabla de acudientes -->
      <div class="dark:bg-slate-950/90 rounded-2xl shadow-xl overflow-hidden border border-gray-200 dark:border-gray-700">
        <table id="tableAcudientes" class="w-full text-sm text-left text-gray-900 dark:text-gray-200">
          <thead class=" dark:bg-gray-800 text-gray-700 dark:text-gray-300 uppercase text-xs tracking-wider">
            <tr>
              <th class="px-6 py-3 text-gray-900 dark:text-gray-100">Documento</th>
              <th class="px-6 py-3 text-gray-900 dark:text-gray-100">Nombre</th>
              <th class="px-6 py-3 text-gray-900 dark:text-gray-100">Teléfono</th>
              <th class="px-6 py-3 text-gray-900 dark:text-gray-100">Correo</th>
              <th class="px-6 py-3 text-gray-900 dark:text-gray-100">Dirección</th>
              <th class="px-6 py-3 text-gray-900 dark:text-gray-100">Parentesco</th>
              <th class="px-6 py-3 text-center text-gray-900 dark:text-gray-100">Acciones</th>
            </tr>
          </thead>
          <tbody id="tbodyAcudientes" class="divide-y  divide-gray-200 dark:divide-gray-700">
            <!-- se rellena desde JS -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Modal -->
  <div id="modalAcudiente" class="hidden fixed inset-0 bg-black bg-opacity-60 items-center justify-center z-50">
    <div class="bg-slate-900 text-gray-100 p-8 rounded-2xl shadow-2xl w-[500px] max-h-[90vh] overflow-y-auto">
      <h2 id="modalTitulo" class="text-2xl font-bold mb-6 border-b border-slate-700 pb-2">Detalle del Acudiente</h2>

      <div id="modalContenido" class="grid grid-cols-1 gap-4"></div>

      <div class="flex justify-end gap-3 mt-6">
        <button id="modalCloseBtn" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-gray-100 rounded-lg transition">Cerrar</button>
        <button id="btnGuardar" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg transition hidden">Guardar</button>
      </div>
    </div>
  </div>
</General>

<script is:inline type="module">

(async function () {
  // DOM
  const table = document.getElementById("tableAcudientes");
  const tbody = document.getElementById("tbodyAcudientes");
  const modal = document.getElementById("modalAcudiente");
  const modalTitulo = document.getElementById("modalTitulo");
  const modalContenido = document.getElementById("modalContenido");
  const modalCloseBtn = document.getElementById("modalCloseBtn");
  const btnGuardar = document.getElementById("btnGuardar");

  let datatable = null;
  let acudientes = [];

  const DATATABLE_OPTIONS = {
    searchable: true,
    fixedHeight: true,
    perPage: 5,
    labels: {
      placeholder: "Buscar...",
      perPage: "Registros por página",
      noRows: "No hay acudientes para mostrar",
      info: "Mostrando {start} a {end} de {rows} registros",
    },
  };

  // Cargar datos + (re)inicializar datatable
  async function cargarAcudientes() {
    if (datatable && typeof datatable.destroy === "function") {
      try { datatable.destroy(); } catch {}
      datatable = null;
    }

    try {
      const res = await fetch("http://localhost:3000/api/datos/acudientes");
      if (!res.ok) throw new Error("HTTP " + res.status);
      acudientes = await res.json();
    } catch (err) {
      console.error("Error cargando acudientes:", err);
      tbody.innerHTML = `<tr><td colspan="7" class="px-4 py-3 text-center text-gray-400">Error cargando acudientes</td></tr>`;
      return;
    }

    renderRows();
    datatable = new simpleDatatables.DataTable("#tableAcudientes", DATATABLE_OPTIONS);
  }

  // Render filas
  function renderRows() {
    tbody.innerHTML = "";
    if (!Array.isArray(acudientes) || acudientes.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" class="px-4 py-3 text-center text-gray-400">No hay acudientes registrados</td></tr>`;
      return;
    }

    const frag = document.createDocumentFragment();
    acudientes.forEach(a => {
      const tr = document.createElement("tr");
      tr.className = "hover:bg-gray-100 dark:hover:bg-gray-700";

      const td = (txt, cls = "") => {
        const cell = document.createElement("td");
        cell.className = `px-4 py-3 border-b border-gray-200 dark:border-gray-700 ${cls} text-gray-550 dark:text-gray-400`.trim();
        cell.textContent = txt ?? "";
        return cell;
      };

      tr.appendChild(td(a.id_documento_acudiente));
      tr.appendChild(td(`${a.acud_nombres ?? ""} ${a.acud_apellidos ?? ""}`));
      tr.appendChild(td(a.acud_telefono));
      tr.appendChild(td(a.acud_correo));
      tr.appendChild(td(a.acud_direccion));
      tr.appendChild(td(a.acud_parentesco));

      // acciones
      const actionsTd = document.createElement("td");
      actionsTd.className = "px-4 py-3 border-b border-gray-200 dark:border-gray-700 text-center space-x-2";

      const btnFactory = (action, label, cls) => {
        const b = document.createElement("button");
        b.type = "button";
        b.dataset.id = a.id_documento_acudiente;
        b.dataset.action = action;
        b.className = cls;
        b.textContent = label;
        return b;
      };

      actionsTd.appendChild(btnFactory("ver", "Ver", "px-2 py-1 rounded bg-blue-600 hover:bg-blue-700 text-white text-xs"));
      actionsTd.appendChild(btnFactory("editar", "Editar", "px-2 py-1 rounded bg-yellow-600 hover:bg-yellow-700 text-white text-xs"));
      actionsTd.appendChild(btnFactory("eliminar", "Eliminar", "px-2 py-1 rounded bg-red-600 hover:bg-red-700 text-white text-xs"));

      tr.appendChild(actionsTd);
      frag.appendChild(tr);
    });

    tbody.appendChild(frag);
  }

  // Modal
  function abrirModal(acudiente, modo = "ver") {
    if (!acudiente) return;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    modalTitulo.textContent = modo === "ver" ? "Detalle del Acudiente" : "Editar Acudiente";

    if (modo === "ver") {
      modalContenido.innerHTML = `
        <div class="space-y-3">
          <div class="p-3 bg-slate-800 rounded-lg"><p class="text-sm text-gray-400">Documento</p><p class="text-lg font-semibold text-gray-200">${acudiente.id_documento_acudiente}</p></div>
          <div class="p-3 bg-slate-800 rounded-lg"><p class="text-sm text-gray-400">Nombre</p><p class="text-lg font-semibold text-gray-200">${acudiente.acud_nombres ?? ""} ${acudiente.acud_apellidos ?? ""}</p></div>
          <div class="p-3 bg-slate-800 rounded-lg"><p class="text-sm text-gray-400">Teléfono</p><p class="text-lg font-semibold text-gray-200">${acudiente.acud_telefono ?? ""}</p></div>
          <div class="p-3 bg-slate-800 rounded-lg"><p class="text-sm text-gray-400">Correo</p><p class="text-lg font-semibold text-gray-200">${acudiente.acud_correo ?? ""}</p></div>
          <div class="p-3 bg-slate-800 rounded-lg"><p class="text-sm text-gray-400">Dirección</p><p class="text-lg font-semibold text-gray-200">${acudiente.acud_direccion ?? ""}</p></div>
          <div class="p-3 bg-slate-800 rounded-lg"><p class="text-sm text-gray-400">Parentesco</p><p class="text-lg font-semibold text-gray-200">${acudiente.acud_parentesco ?? ""}</p></div>
        </div>
      `;
      btnGuardar.classList.add("hidden");
    } else {
      modalContenido.innerHTML = `
        <div class="space-y-4">
          <label class="block">
            <span class="text-sm text-gray-300">Nombre</span>
            <input type="text" id="editNombres" value="${acudiente.acud_nombres ?? ""}"
              class="mt-1 w-full p-2 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-gray-100 border border-gray-300 dark:border-slate-700 focus:border-blue-500 focus:ring focus:ring-blue-500/40"/>
          </label>
          <label class="block">
            <span class="text-sm text-gray-300">Apellidos</span>
            <input type="text" id="editApellidos" value="${acudiente.acud_apellidos ?? ""}"
              class="mt-1 w-full p-2 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-gray-100 border border-gray-300 dark:border-slate-700 focus:border-blue-500 focus:ring focus:ring-blue-500/40"/>
          </label>
          <label class="block">
            <span class="text-sm text-gray-300">Teléfono</span>
            <input type="text" id="editTelefono" value="${acudiente.acud_telefono ?? ""}"
              class="mt-1 w-full p-2 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-gray-100 border border-gray-300 dark:border-slate-700 focus:border-blue-500 focus:ring focus:ring-blue-500/40"/>
          </label>
          <label class="block">
            <span class="text-sm text-gray-300">Correo</span>
            <input type="email" id="editCorreo" value="${acudiente.acud_correo ?? ""}"
              class="mt-1 w-full p-2 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-gray-100 border border-gray-300 dark:border-slate-700 focus:border-blue-500 focus:ring focus:ring-blue-500/40"/>
          </label>
          <label class="block">
            <span class="text-sm text-gray-300">Dirección</span>
            <input type="text" id="editDireccion" value="${acudiente.acud_direccion ?? ""}"
              class="mt-1 w-full p-2 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-gray-100 border border-gray-300 dark:border-slate-700 focus:border-blue-500 focus:ring focus:ring-blue-500/40"/>
          </label>
          <label class="block">
            <span class="text-sm text-gray-300">Parentesco</span>
            <select id="editParentesco" class="mt-1 w-full p-2 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-gray-100 border border-gray-300 dark:border-slate-700 focus:border-blue-500 focus:ring focus:ring-blue-500/40">
              <option value="Padre" ${acudiente.acud_parentesco === "Padre" ? "selected" : ""}>Padre</option>
              <option value="Madre" ${acudiente.acud_parentesco === "Madre" ? "selected" : ""}>Madre</option>
              <option value="Abuelo" ${acudiente.acud_parentesco === "Abuelo" ? "selected" : ""}>Abuelo</option>
              <option value="Otro" ${acudiente.acud_parentesco === "Otro" ? "selected" : ""}>Otro</option>
            </select>
          </label>
        </div>
      `;
      btnGuardar.dataset.id = acudiente.id_documento_acudiente;
      btnGuardar.classList.remove("hidden");
    }
  }

  function cerrarModal() { modal.classList.add("hidden"); }

  // Delegación eventos tabla
  table.addEventListener("click", (ev) => {
    const btn = ev.target.closest("button[data-action]");
    if (!btn) return;
    const id = btn.dataset.id;
    const action = btn.dataset.action;
    const acudiente = acudientes.find(a => String(a.id_documento_acudiente) === String(id));
    if (action === "ver") abrirModal(acudiente, "ver");
    else if (action === "editar") abrirModal(acudiente, "editar");
    else if (action === "eliminar") eliminarAcudiente(id);
  });

  // Guardar edición
  btnGuardar.addEventListener("click", async () => {
    const id = btnGuardar.dataset.id;
    const payload = {
      id_documento_acudiente: id,
      acud_nombres: document.getElementById("editNombres").value,
      acud_apellidos: document.getElementById("editApellidos").value,
      acud_telefono: document.getElementById("editTelefono").value,
      acud_correo: document.getElementById("editCorreo").value,
      acud_direccion: document.getElementById("editDireccion").value,
      acud_parentesco: document.getElementById("editParentesco").value
    };

    try {
      const res = await fetch(`http://localhost:3000/api/datos/acudientes/${id}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });
      if (res.ok) {
        const idx = acudientes.findIndex(x => String(x.id_documento_acudiente) === String(id));
        if (idx !== -1) {
          acudientes[idx] = { ...acudientes[idx], ...payload };
          if (datatable && typeof datatable.destroy === "function") { datatable.destroy(); datatable = null; }
          renderRows();
          datatable = new simpleDatatables.DataTable("#tableAcudientes", DATATABLE_OPTIONS);
        } else {
          await cargarAcudientes();
        }
        cerrarModal();
      } else {
        alert("Error al actualizar");
      }
    } catch (err) {
      console.error(err);
      alert("Error de conexión");
    }
  });

  // Eliminar
  async function eliminarAcudiente(id) {
    if (!confirm("¿Seguro que quieres eliminar este acudiente?")) return;
    try {
      const res = await fetch(`http://localhost:3000/api/datos/acudientes/${id}`, { method: "DELETE" });
      if (res.ok) {
        acudientes = acudientes.filter(a => String(a.id_documento_acudiente) !== String(id));
        if (datatable && typeof datatable.destroy === "function") { datatable.destroy(); datatable = null; }
        renderRows();
        datatable = new simpleDatatables.DataTable("#tableAcudientes", DATATABLE_OPTIONS);
        alert("Acudiente eliminado");
      } else {
        alert("Error al eliminar");
      }
    } catch (err) {
      console.error(err);
      alert("Error de conexión");
    }
  }

  // Cerrar modal
  modalCloseBtn.addEventListener("click", cerrarModal);
  modal.addEventListener("click", (e) => { if (e.target === modal) cerrarModal(); });

  // Init
  await cargarAcudientes();
})();
</script>
