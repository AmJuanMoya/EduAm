---
import Panelnav from "../../components/navigation/panelnav.astro";
import General from "../../layouts/general.astro";
import Asidebar from "../../components/asidebar.astro";

---

<General>
<Panelnav/>    

<main class="   flex">
    <Asidebar/>
    <div class=" w-full mx-5 ">
        
        <form id="registroAcudienteForm" action="" method="POST" class=" dark:bg-slate-950/90 w-[75%]  mx-auto p-5 overflow-auto resize ">
          <h1 class="text-center text-3xl my-3">Registro de Acudientes</h1>
            <fieldset class="border border-slate-500/50 p-3 rounded-lg "> <legend class="">DATOS DEl ACUDIENTE</legend>

                <div class="mx-auto w-fit">
                 <label for="acud_nombres" class="block  w-50"> Primer Nombre: <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span>  </label>
                 <input id="acud_nombres" name="acud_nombres" type="text" placeholder="Kevin" class="m-5 rounded-sm w-200" required>
                </div>

                 <div class="mx-auto w-fit">
                 <label for="acud_apellidos" class="block  w-50"> Primer Apellido: <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span>  </label>
                 <input id="acud_apellidos" name="acud_apellidos" type="text" placeholder="Carrillo" class="m-5 rounded-sm w-200" required>
                </div>

                 <div class="mx-auto w-fit">    
                  <label for="id_documento_acudiente" class="block w-50 ">Numero de Documento:  <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span> </label>
                  <div class="m-5 flex  w-200 ">
                    <select name="acud_tipo_documento" id="acud_tipo_documento" class="rounded-l-md" required>
                      <option value="CC">C.C</option>
                      <option value="TI">T.I</option>
                      <option value="CE">C.E</option>
                      
                    </select>
                    <input id="id_documento_acudiente" name="id_documento_acudiente" type="text" placeholder=1000009  class="rounded-r-sm w-190 " maxlength="10" required >
                  </div>
                </div>

                <div class="mx-auto w-fit mt-5">    
                  <label for="acud_parentesco" class="block w-fit ">Parentesco: <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span> </label>
                  <select name="acud_parentesco" id="estu_parentesco" class="m-5 rounded-sm w-200" required>
                    <option  selected disabled value="0" class=""  >Seleccione</option>
                    <option value="Padre">Padre</option>
                    <option value="Madre">Madre</option>
                    <option value="Abuelo">Abuela</option>
                    <option value="Otro">Otro</option>
                  </select>
                </div>


                <div class="mx-auto w-fit">
                 <label for="acud_telefono" class="block  w-50">Telefono de Contacto: <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span></label>
                 <input id="acud_telefono" name="acud_telefono" type="text" placeholder="123456789" class="m-5 rounded-sm w-200" required>
                </div>

                <div class="mx-auto w-fit">
                 <label for="acud_correo" class="block  w-50">Correo electronico: <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span> </label>
                 <input id="acud_correo" name="acud_correo" type="email" placeholder="kevinM@gmail.com" class="m-5 rounded-sm w-200" required>
                </div>

                <div class="mx-auto w-fit">    
                  <label for="acud_direccion" class="block w-50 ">Direccion de Residencia  <span class="text-red-600  text-xl ml-1 -mt-1.5">*</span> </label>
                  <input id="acud_direccion" name="acud_direccion" type="text"  placeholder="Carrera 19 A # 1-1 Puente aranda" class="m-5 rounded-sm w-200" required>
                </div>

            </fieldset>

            <div class="flex justify-center mt-8">
          <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50">
            Registrar Acudiente
          </button>
        </div>

        </form>
    </div>
</main>

</General>

<main class="flex border">

<div class=" w-full mx-5 ">
<!-- <form id="registroMatriculaForm" action="" method="POST" class=" dark:bg-slate-950/90 w-[75%] mx-auto p-5 overflow-auto resize ">
</form> -->
</div>

    <div id="statusModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white  dark:bg-slate-800 p-8 rounded-lg shadow-xl max-w-sm w-full transform transition-all scale-95 duration-300">
            <div class="text-center">
                <div id="modalIcon" class="text-6xl mb-4"></div>
                <h3 id="modalTitle" class="text-2xl font-bold mb-3 text-gray-900 dark:text-white"></h3>
                <p id="modalMessage" class="text-gray-700 dark:text-gray-300 mb-6"></p>
                <button id="closeModalBtn" class="bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</main>

<script is:inline>
    const form = document.getElementById('registroAcudienteForm');
    const statusModal = document.getElementById('statusModal');
    const modalIcon = document.getElementById('modalIcon');
    const modalTitle = document.getElementById('modalTitle');
    const modalMessage = document.getElementById('modalMessage');
    const closeModalBtn = document.getElementById('closeModalBtn');

    // Función para mostrar el modal
    function showModal(icon, title, message) {
        modalIcon.textContent = icon;
        modalTitle.textContent = title;
        modalMessage.textContent = message;
        statusModal.classList.remove('hidden');
        // Opcional: añadir una animación de entrada
        statusModal.querySelector('div').classList.remove('scale-95');
        statusModal.querySelector('div').classList.add('scale-100');
    }

    // Función para ocultar el modal
    function hideModal() {
        // Opcional: añadir una animación de salida
        statusModal.querySelector('div').classList.remove('scale-100');
        statusModal.querySelector('div').classList.add('scale-95');
        setTimeout(() => { // Esperar la animación antes de ocultar completamente
            statusModal.classList.add('hidden');
        }, 300); // Coincide con la duración de la transición CSS
    }

    // Event listener para el botón de cerrar modal
    closeModalBtn.addEventListener('click', hideModal);

    // Event listener para cerrar el modal haciendo clic fuera de él
    statusModal.addEventListener('click', (event) => {
        if (event.target === statusModal) {
            hideModal();
        }
    });

    form.addEventListener('submit', async (event) => {
        event.preventDefault(); // Evitar el envío predeterminado del formulario

        const formData = new FormData(form);
        const data = {};

        // // Convertir FormData a un objeto JSON
        for (const [key, value] of formData.entries()) {
            if (key === 'repitente') {
                data[key] = value === 'true'; // Manejar el radio button 'repitente' para que sea un booleano
            } else if (key === 'estrato') {
                data[key] = parseInt(value); // Convertir 'estrato' a entero
            } else if (value === '') { // Para campos de texto opcionales, enviar null en lugar de string vacío
                data[key] = null; // Esto es útil si tu DB permite NULL para campos opcionales
                                  // Si tu DB espera string vacío para NOT NULL, cámbialo a data[key] = '';
            } else {
                data[key] = value; // Para todos los demás campos, asignar el valor directamente
            }
        }
        console.log('Datos a enviar:', data); // Para depuración

        try {
            const response = await fetch('http://localhost:3000/api/datos/acudiente', { // Asegúrate que esta URL sea la correcta
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });

            if (response.ok) {
                const result = await response.json();
                // Reemplazar alert por showModal para éxito
                showModal('✅', '¡Registro Exitoso!', result.message);
                form.reset(); // Limpiar el formulario después del éxito
            } else {
                const errorData = await response.json();
                // Reemplazar alert por showModal para error
                showModal('❌', 'Error al Registrar', errorData.message || 'Ocurrió un error inesperado.');
                console.error('Error del servidor:', errorData);
            }
        } catch (error) {
            // Reemplazar alert por showModal para error de conexión
            showModal('⚠️', 'Error de Conexión', 'Ocurrió un error al conectar con el servidor. Intente de nuevo más tarde.');
            console.error('Error de red o de solicitud:', error);
        }
    });
</script>